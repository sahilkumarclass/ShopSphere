{
  "title": "ShopSphere JVM Overview",
  "uid": "shopsphere-jvm",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["shopsphere", "jvm"],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Up",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "JVM Memory Used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=~\"$job\"}", "legendFormat": "{{job}} {{area}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Server Requests (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"$job\"}[1m]))", "legendFormat": "{{job}} {{uri}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "process_cpu_usage{job=~\"$job\"}", "legendFormat": "{{job}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GC Pause Time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[1m])", "legendFormat": "{{job}} {{action}}" }
      ]
    }
  ]
}
